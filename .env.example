# Copy to .env and adjust. Everything has a repo-relative default, so .env is
# only needed when artifacts should live off the repo volume.

# Where datasets, sweeps and results are written (2-3 GB for a full run).
INNERJ_DATA_ROOT=./data

# Long-running job logs.
INNERJ_LOG_DIR=./logs

# Hugging Face cache. Set this, or a bare `hf download` re-pulls ~52 GB.
HF_HOME=~/.cache/huggingface
